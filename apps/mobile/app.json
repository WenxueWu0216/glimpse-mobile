{
  "expo": {
    "name": "Glimpse",
    "slug": "glimpse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wenxuewu.glimpse"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0456A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wenxuewu.glimpse"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-sqlite",
      "expo-image",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F5F5F2",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F0F11"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Glimpse uses your photos so you can attach them to a note."
        }
      ]
    ],
    "scheme": "glimpse"
  }
}
